# /etc/btn-ops/backup.env — settings for deploy/backup.sh and deploy/restore-test.sh (SRS NFR-R1).
# Owner root:btnops, mode 640. Sourced by bash: quote values that contain spaces or shell characters.

# --- Source database -----------------------------------------------------------------------------
# Preferably a dedicated role that can only read:  CREATE ROLE btn_backup LOGIN PASSWORD '...';
#                                                  GRANT pg_read_all_data TO btn_backup;   (PG 14+)
# The scripts move the password into PGPASSWORD so it never appears in `ps`.
DATABASE_URL='postgresql://btn_backup:CHANGE_ME@127.0.0.1:5432/btn_ops?sslmode=disable'
# PostgreSQL client tools, same or newer major version than the server (optional).
#PG_BIN=/usr/lib/postgresql/17/bin

# --- Local storage + retention -------------------------------------------------------------------
BACKUP_DIR=/var/backups/btn-ops
BACKUP_KEEP_DAILY=14       # newest N nightly backups
BACKUP_KEEP_WEEKLY=8       # newest N Sunday backups (0 disables the tier)
BACKUP_KEEP_MONTHLY=12     # newest N 1st-of-month backups (0 disables the tier)
#BACKUP_TZ=Africa/Kigali   # time zone for file names and the Sunday / 1st-of-month rules

# --- Encryption (one of these is required) -------------------------------------------------------
# Option A (preferred): age public-key encryption. Only the PUBLIC key lives on the server; keep the
# identity (private key) offline/off-site (password manager + printed copy in the safe).
#   age-keygen -o btn-backup.key   →  prints "Public key: age1..."
#BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#BACKUP_AGE_RECIPIENTS_FILE=/etc/btn-ops/backup.recipients   # alternative: one recipient per line
# Only for verification/restore on a machine that holds the identity (NOT on the server normally):
#BACKUP_AGE_IDENTITY=/root/btn-backup.key
#
# Option B: gpg symmetric AES-256 with a passphrase file (mode 400, owner btnops). Store a copy of
# the passphrase off the server too — losing it means losing every backup.
#   head -c 48 /dev/urandom | base64 > /etc/btn-ops/backup.pass && chmod 400 /etc/btn-ops/backup.pass
BACKUP_PASSPHRASE_FILE=/etc/btn-ops/backup.pass
#BACKUP_PASSPHRASE=...     # alternative to the file (passed to gpg on a file descriptor)
#
# Last resort, NOT recommended: allow an unencrypted dump when no key is configured.
#BACKUP_ALLOW_PLAINTEXT=1

# --- Off-site copy (rclone) ----------------------------------------------------------------------
# Configure the remote once:  rclone --config /etc/btn-ops/rclone.conf config   (e.g. Backblaze B2,
# S3, Wasabi, Google Drive). Use credentials limited to this bucket. Files go to <remote>/<tier>/.
#BACKUP_RCLONE_REMOTE=b2:btn-ops-backups
#RCLONE_CONFIG=/etc/btn-ops/rclone.conf
#BACKUP_RCLONE_PRUNE=1     # also apply the retention above to the remote
#BACKUP_RCLONE_FLAGS='--b2-hard-delete'

# --- Restore test (deploy/restore-test.sh) -------------------------------------------------------
# Server + maintenance DB where the scratch database is created (role needs CREATEDB). Defaults to
# DATABASE_URL; better: a separate restore/staging server.
#RESTORE_DATABASE_URL='postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres'
#RESTORE_REPORT_DIR=/var/backups/btn-ops/restore-reports
