# /etc/btn-ops/uptime.env — settings for deploy/uptime-check.sh, the EXTERNAL uptime probe (SRS NFR-M2).
# Install it on a machine other than the API server. Owner root, mode 640 (systemd reads it as root via
# EnvironmentFile=). Plain KEY=value lines: no comments after a value (systemd does not strip them).

# What to probe. Either a base URL (checks <base>/api/health?db=1 — API + database — and <base>/ — the web app) …
UPTIME_BASE_URL=https://operations.btnlimited.com
# … or an explicit, space-separated list (overrides UPTIME_BASE_URL), e.g. when the API has its own domain:
#UPTIME_URLS="https://operation-api.btnlimited.com/api/health?db=1 https://operations.btnlimited.com/"
UPTIME_NAME="BTN Operations"

# A check fails on no answer within UPTIME_TIMEOUT seconds, a non-2xx status, a health body without "ok":true,
# or a response slower than UPTIME_MAX_LATENCY_MS.
UPTIME_TIMEOUT=10
UPTIME_MAX_LATENCY_MS=5000
# Alert after this many failed runs in a row (the timer runs every minute → 2 = down for ~2 minutes),
# then remind every UPTIME_REPEAT_MINUTES while it stays down; a "recovered" notice follows when it is back.
UPTIME_FAILS_BEFORE_ALERT=2
UPTIME_REPEAT_MINUTES=60

# --- Alert channels (set at least one) ---------------------------------------------------------
# E-mail (comma-separated recipients). With UPTIME_SMTP_URL the mail goes through curl's SMTP client;
# without it the local `sendmail` is used. Use an SMTP account that is NOT on the API server.
UPTIME_ALERT_EMAIL=ops@example.com
# smtp://host:587 (STARTTLS) or smtps://host:465 (implicit TLS); TLS is required either way.
UPTIME_SMTP_URL=smtp://mail.example.com:587
UPTIME_SMTP_USER=monitor@example.com
# Password: under systemd put it in /etc/btn-ops/uptime.smtp-pass (root, mode 400); the unit hands it to the probe as a
# credential. Outside systemd point UPTIME_SMTP_PASSWORD_FILE at a readable file (or set UPTIME_SMTP_PASSWORD, less safe).
#UPTIME_SMTP_PASSWORD_FILE=/etc/btn-ops/uptime.smtp-pass
UPTIME_MAIL_FROM="BTN uptime <monitor@example.com>"
# Webhook: JSON POST {"text": "..."} — Slack / Mattermost / Google Chat incoming webhooks, ntfy.sh topics, …
#UPTIME_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Extra curl options for the probe and webhook (e.g. --resolve to pin an IP, -4).
#UPTIME_CURL_OPTS="-4"
#UPTIME_STATE_DIR=/var/lib/btn-ops-uptime
