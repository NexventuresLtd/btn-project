# BTN Operations API — copy to .env and fill in. The server also reads real environment variables
# (they win over this file).

# development | production. Production enables Secure cookies and disables dev-only helpers.
APP_ENV=production
PORT=4000
LOG_LEVEL=info

# PostgreSQL. Use sslmode=require when the database is on another host.
DATABASE_URL="postgresql://btn_ops:CHANGE_ME@db:5432/btn_ops?sslmode=disable"

# Public URL of the web app, and the origin(s) allowed to call the API (comma-separated).
APP_URL="https://ops.btnlimited.com"
FRONTEND_ORIGIN="https://ops.btnlimited.com"
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs).
TRUSTED_PROXIES="127.0.0.1,172.16.0.0/12"

# 64 hex chars: openssl rand -hex 32  (keep it secret; changing it invalidates pending codes)
OTP_PEPPER="CHANGE_ME"

# Outgoing mail for sign-in codes (587 = STARTTLS, 465 = TLS)
SMTP_HOST="mail.example.com"
SMTP_PORT=587
SMTP_USER="security@example.com"
SMTP_PASSWORD="CHANGE_ME"
MAIL_FROM="BTN Manufacturing <security@example.com>"

# First Super Administrator, created by `seed` if it does not exist.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_PASSWORD="CHANGE_ME"

# Passkeys (WebAuthn): RP ID = the bare domain users visit; origins must be https (or http://localhost).
WEBAUTHN_RP_ID="ops.btnlimited.com"
WEBAUTHN_RP_NAME="BTN Operations"
WEBAUTHN_ORIGINS="https://ops.btnlimited.com"

# Development only: also print sign-in codes to the log. Ignored when APP_ENV=production.
AUTH_DEV_LOG_OTP=false
